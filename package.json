{
  "name": "praztech-catalogue-portal",
  "version": "1.0.0",
  "description": "PRAZTECH Engineering B2B Product Catalogue & Quotation Enquiry Website",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "node server/src/index.js",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "export": "npm --prefix server run export",
    "import:images": "python3 scripts/import_product_images.py"
  },
  "dependencies": {
    "cloudinary": "^2.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.2",
    "helmet": "^7.1.0",
    "mongoose": "^8.3.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.15.0",
    "resend": "^3.2.0",
    "slugify": "^1.6.6",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "keywords": ["b2b", "catalogue", "rfq", "praztech", "react", "express", "mongodb"],
  "author": "PRAZTECH Engineering",
  "license": "ISC"
}
